model User {
  id         Int      @id @default(autoincrement())
  name       String?
  surname    String?
  age        Int?
  gender     String?
  email      String   @unique
  password   String
  avatar     String?
  website    String?
  blog       String?
  cv         String?  @db.Text
  github     String?
  linkedin   String?
  mobile     String?
  role       Role     @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastLogin  DateTime?
  logs       Log[]
}

model Log {
  id         Int      @id @default(autoincrement())
  eventType  EventType
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  data       Json
  createdAt  DateTime @default(now())
}

model Topic {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pages     Page[]
}

model Page {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String
  content   Json
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, slug])
}

enum Role {
  ADMIN
  EDITOR
  USER
}

enum EventType {
  LOGIN_ATTEMPT
  LOGIN_SUCCESS
  PAGE_LOAD
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  industry  String
  subject   String
  message   String
  location  String?
  createdAt DateTime @default(now())
}

model NewsletterSubscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}